@using System.Text.Encodings.Web
@using System.Text.Json
@using System.Text.Json.Nodes
@using AutoWorks.Runtime

@if (Runtime is null)
{
    <MudPaper Class="pa-3" Outlined="true">
        <MudText Typo="Typo.subtitle1">Tools and capabilities</MudText>
        <MudText Typo="Typo.body2" Class="mt-2">Connect to MCP from the Chat tab to load the live tool catalog.</MudText>
    </MudPaper>
}
else
{
    <MudStack Spacing="2">
        <MudPaper Class="pa-3" Outlined="true">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle1">Tools and capabilities</MudText>
                    <MudText Typo="Typo.body2">@_statusText</MudText>
                </MudStack>
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <MudButton Variant="Variant.Outlined" OnClick="RefreshAsync" Disabled="@_isRefreshing">Refresh</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunSelectedValidationAsync" Disabled="@(!CanRunSelectedTool)">Run validation</MudButton>
                </MudStack>
            </MudStack>
            @if (_isRefreshing)
            {
                <MudProgressLinear Class="mt-2" Color="Color.Info" Indeterminate="true" />
            }
        </MudPaper>

        <MudGrid Spacing="2">
            <MudItem xs="12" md="5">
                <MudPaper Class="pa-3" Outlined="true" Style="max-height: calc(100dvh - 260px); overflow:auto;">
                    <MudText Typo="Typo.subtitle2">Capability tree</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Available tools are marked in green. Missing upstream features are marked in red.</MudText>

                    <MudTreeView T="string"
                                 Class="mt-2"
                                 Dense="true"
                                 Hover="true"
                                 SelectionMode="SelectionMode.SingleSelection"
                                 SelectedValue="@_selectedToolName"
                                 SelectedValueChanged="OnSelectedToolChanged">
                        @foreach (var group in _groups)
                        {
                            <MudTreeViewItem T="string" Text="@group.Title" Value="@group.Title" Expanded="true">
                                @foreach (var tool in group.Tools)
                                {
                                    <MudTreeViewItem T="string"
                                                     Text="@tool.Label"
                                                     Value="@tool.Name"
                                                     Expanded="false"
                                                     Icon="@(tool.IsAvailable ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)" />
                                }
                            </MudTreeViewItem>
                        }
                    </MudTreeView>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="7">
                <MudPaper Class="pa-3" Outlined="true" Style="max-height: calc(100dvh - 260px); overflow:auto;">
                    @if (SelectedTool is null)
                    {
                        <MudText Typo="Typo.body2">Select a tool from the tree to inspect its schema and smoke-test it.</MudText>
                    }
                    else
                    {
                        <MudStack Spacing="2">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle2">@SelectedTool.Label</MudText>
                                    <MudText Typo="Typo.body2">@SelectedTool.Description</MudText>
                                </MudStack>
                                <MudChip T="string" Color="@GetToolStatusColor(SelectedTool.IsAvailable)" Variant="Variant.Filled">@SelectedTool.StatusLabel</MudChip>
                            </MudStack>

                            <MudPaper Class="pa-3" Outlined="true">
                                <MudText Typo="Typo.caption">Selected tool</MudText>
                                <MudText Typo="Typo.body1">@SelectedTool.Name</MudText>
                            </MudPaper>

                            <MudPaper Class="pa-3" Outlined="true">
                                <MudText Typo="Typo.subtitle2">Input schema</MudText>
                                @if (SelectedTool.InputSchemaJson is null)
                                {
                                    <MudText Typo="Typo.body2" Class="mt-2">No schema was returned by the MCP server.</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@SelectedTool.InputSchemaJson</MudText>
                                }
                            </MudPaper>

                            <MudPaper Class="pa-3" Outlined="true">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.subtitle2">Validation</MudText>
                                    @if (IsSolidWorksStyleValidationSupportedTool(SelectedTool.Name))
                                    {
                                        <MudSwitch T="bool"
                                                   @bind-Value="_useAdvancedJsonEditor"
                                                   Color="Color.Primary"
                                                   Label="Advanced JSON editor" />
                                    }
                                </MudStack>
                                <MudText Typo="Typo.body2" Class="mt-2">@SelectedTool.ValidationNote</MudText>

                                @if (IsAddTool(SelectedTool.Name) && _addToolTypeOptions.Count > 0 && !string.IsNullOrWhiteSpace(_addToolTypePropertyName))
                                {
                                    <MudPaper Class="pa-2 mt-2" Outlined="true">
                                        <MudText Typo="Typo.caption">SolidWorks type picker</MudText>
                                        <MudSelect T="string" @bind-Value="_selectedAddToolType" Variant="Variant.Outlined" Dense="true" Class="mt-1" Label="@($"{_addToolTypePropertyName} type")">
                                            @foreach (var option in _addToolTypeOptions)
                                            {
                                                <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudPaper>
                                }

                                @if (ShowSolidWorksStyleValidationForm && IsCircleValidationTool(SelectedTool.Name))
                                {
                                    <MudExpansionPanels Class="mt-2" MultiExpansion="true">
                                        <MudExpansionPanel Text="Circle Type" Expanded="true">
                                            <MudRadioGroup T="string" @bind-Value="_circleFormState.CircleType">
                                                <MudRadio T="string" Value="@( "center_radius" )" Dense="true">Center, Radius</MudRadio>
                                                <MudRadio T="string" Value="@("3_point")" Dense="true">3 Point (preview)</MudRadio>
                                            </MudRadioGroup>
                                        </MudExpansionPanel>

                                        <MudExpansionPanel Text="Existing Relations" Expanded="true">
                                            <MudText Typo="Typo.caption">Relation discovery from live sketch entities will be added as more tools are form-enabled.</MudText>
                                            <MudChip T="string" Class="mt-2" Color="Color.Info" Variant="Variant.Outlined">Under Defined</MudChip>
                                        </MudExpansionPanel>

                                        <MudExpansionPanel Text="Add Relations" Expanded="true">
                                            <MudCheckBox T="bool" @bind-Value="_circleFormState.AddFixRelation" Label="Fix" Dense="true" />
                                        </MudExpansionPanel>

                                        <MudExpansionPanel Text="Options" Expanded="true">
                                            <MudCheckBox T="bool" @bind-Value="_circleFormState.ForConstruction" Label="For construction" Dense="true" />
                                        </MudExpansionPanel>

                                        <MudExpansionPanel Text="Parameters" Expanded="true">
                                            <MudNumericField T="double" @bind-Value="_circleFormState.CenterXmm" Label="Center X (mm)" Variant="Variant.Outlined" Immediate="true" />
                                            <MudNumericField T="double" @bind-Value="_circleFormState.CenterYmm" Label="Center Y (mm)" Variant="Variant.Outlined" Immediate="true" Class="mt-2" />
                                            <MudNumericField T="double" @bind-Value="_circleFormState.RadiusMm" Label="Radius (mm)" Variant="Variant.Outlined" Immediate="true" Min="0.001" Class="mt-2" />
                                        </MudExpansionPanel>
                                    </MudExpansionPanels>
                                }
                                else if (ShowSolidWorksStyleValidationForm && IsLineValidationTool(SelectedTool.Name))
                                {
                                    <MudExpansionPanels Class="mt-2" MultiExpansion="true">
                                        <MudExpansionPanel Text="Line Type" Expanded="true">
                                            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">Centerline-style entry (2-point)</MudChip>
                                        </MudExpansionPanel>
                                        <MudExpansionPanel Text="Options" Expanded="true">
                                            <MudCheckBox T="bool" @bind-Value="_lineFormState.ForConstruction" Label="For construction" Dense="true" />
                                        </MudExpansionPanel>
                                        <MudExpansionPanel Text="Parameters" Expanded="true">
                                            <MudNumericField T="double" @bind-Value="_lineFormState.X1mm" Label="Start X (mm)" Variant="Variant.Outlined" Immediate="true" />
                                            <MudNumericField T="double" @bind-Value="_lineFormState.Y1mm" Label="Start Y (mm)" Variant="Variant.Outlined" Immediate="true" Class="mt-2" />
                                            <MudNumericField T="double" @bind-Value="_lineFormState.X2mm" Label="End X (mm)" Variant="Variant.Outlined" Immediate="true" Class="mt-2" />
                                            <MudNumericField T="double" @bind-Value="_lineFormState.Y2mm" Label="End Y (mm)" Variant="Variant.Outlined" Immediate="true" Class="mt-2" />
                                        </MudExpansionPanel>
                                    </MudExpansionPanels>
                                }
                                else if (ShowSolidWorksStyleValidationForm && IsRectangleValidationTool(SelectedTool.Name))
                                {
                                    <MudExpansionPanels Class="mt-2" MultiExpansion="true">
                                        <MudExpansionPanel Text="Rectangle Type" Expanded="true">
                                            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">Corner Rectangle</MudChip>
                                        </MudExpansionPanel>
                                        <MudExpansionPanel Text="Options" Expanded="true">
                                            <MudCheckBox T="bool" @bind-Value="_rectangleFormState.ForConstruction" Label="For construction" Dense="true" />
                                        </MudExpansionPanel>
                                        <MudExpansionPanel Text="Parameters" Expanded="true">
                                            <MudNumericField T="double" @bind-Value="_rectangleFormState.X1mm" Label="Corner 1 X (mm)" Variant="Variant.Outlined" Immediate="true" />
                                            <MudNumericField T="double" @bind-Value="_rectangleFormState.Y1mm" Label="Corner 1 Y (mm)" Variant="Variant.Outlined" Immediate="true" Class="mt-2" />
                                            <MudNumericField T="double" @bind-Value="_rectangleFormState.X2mm" Label="Corner 2 X (mm)" Variant="Variant.Outlined" Immediate="true" Class="mt-2" />
                                            <MudNumericField T="double" @bind-Value="_rectangleFormState.Y2mm" Label="Corner 2 Y (mm)" Variant="Variant.Outlined" Immediate="true" Class="mt-2" />
                                        </MudExpansionPanel>
                                    </MudExpansionPanels>
                                }
                                else if (ShowSolidWorksStyleValidationForm && IsDimensionValidationTool(SelectedTool.Name))
                                {
                                    <MudExpansionPanels Class="mt-2" MultiExpansion="true">
                                        <MudExpansionPanel Text="Selection" Expanded="true">
                                            <MudCheckBox T="bool" @bind-Value="_dimensionFormState.UseLatestSelection" Label="Use latest tool result selection" Dense="true" />
                                            <MudTextField T="string" @bind-Value="_dimensionFormState.SketchName" Label="Sketch name override" Variant="Variant.Outlined" Class="mt-2" Immediate="true" />
                                            <MudTextField T="string" @bind-Value="_dimensionFormState.SketchSegmentsCsv" Label="Sketch segment handles (comma-separated)" Variant="Variant.Outlined" Class="mt-2" Immediate="true" />
                                            <MudText Typo="Typo.caption" Class="mt-1">Example: L1@Sketch1 or Line1@Sketch1</MudText>
                                        </MudExpansionPanel>
                                        <MudExpansionPanel Text="Dimension Type" Expanded="true">
                                            <MudSelect T="string" @bind-Value="_dimensionFormState.Kind" Variant="Variant.Outlined" Label="Kind">
                                                <MudSelectItem T="string" Value="@( "auto" )">Auto</MudSelectItem>
                                                <MudSelectItem T="string" Value="@( "horizontal" )">Horizontal</MudSelectItem>
                                                <MudSelectItem T="string" Value="@( "vertical" )">Vertical</MudSelectItem>
                                                <MudSelectItem T="string" Value="@( "radius" )">Radius</MudSelectItem>
                                                <MudSelectItem T="string" Value="@( "diameter" )">Diameter</MudSelectItem>
                                            </MudSelect>
                                        </MudExpansionPanel>
                                        <MudExpansionPanel Text="Parameters" Expanded="true">
                                            <MudNumericField T="double" @bind-Value="_dimensionFormState.ValueMm" Label="Value (mm)" Variant="Variant.Outlined" Immediate="true" />
                                            <MudNumericField T="double" @bind-Value="_dimensionFormState.PlaceXmm" Label="Text X (mm)" Variant="Variant.Outlined" Immediate="true" Class="mt-2" />
                                            <MudNumericField T="double" @bind-Value="_dimensionFormState.PlaceYmm" Label="Text Y (mm)" Variant="Variant.Outlined" Immediate="true" Class="mt-2" />
                                        </MudExpansionPanel>
                                    </MudExpansionPanels>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Class="mt-2">Edit the request payload (JSON object) before running the selected tool.</MudText>
                                    <MudTextField T="string"
                                                  Class="mt-2"
                                                  @bind-Value="_validationArgumentsJson"
                                                  Variant="Variant.Outlined"
                                                  Label="Arguments"
                                                  Lines="10"
                                                  Immediate="true"
                                                  FullWidth="true" />
                                    @if (!string.IsNullOrWhiteSpace(_argumentEditorError))
                                    {
                                        <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined" Class="mt-2">@_argumentEditorError</MudAlert>
                                    }
                                }

                                <MudStack Row="true" Spacing="1" Class="mt-2">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunSelectedValidationAsync" Disabled="@(!CanRunSelectedTool)">Run tool test</MudButton>
                                    <MudButton Variant="Variant.Outlined" OnClick="ResetValidationArguments" Disabled="@(!_toolCatalog.Any())">Reset sample payload</MudButton>
                                    <MudButton Variant="Variant.Outlined" OnClick="SelectFirstAvailableTool" Disabled="@(!_toolCatalog.Any())">Select first available</MudButton>
                                </MudStack>
                            </MudPaper>

                            @if (!string.IsNullOrWhiteSpace(_validationResult))
                            {
                                <MudPaper Class="pa-3" Outlined="true">
                                    <MudText Typo="Typo.subtitle2">Latest result</MudText>
                                    <MudText Typo="Typo.body2" Class="mt-2" Style="white-space: pre-wrap;">@_validationResult</MudText>
                                </MudPaper>
                            }
                        </MudStack>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudStack>
}

@code {
    [Parameter] public ChatRuntime? Runtime { get; set; }
    [Parameter] public SkillCatalogSnapshot? SkillCatalog { get; set; }

    private static readonly CapabilityGroupDefinition[] CapabilityGroups =
    [
        new("Session and documents", "Current session, documents, save/export, and setup tools.", ["open_model", "get_active_document_info", "create_part", "create_assembly", "list_part_templates", "launch_solidworks_and_check_connection", "close_model", "save_document", "save_active_document"]),
        new("Reference geometry", "Reference planes and axes.", ["list_reference_planes", "create_plane", "create_axis"]),
        new("Sketching", "Sketch creation, editing, relations, dimensions, and stable sketch handles.", ["create_sketch", "edit_sketch", "close_sketch", "list_sketches", "list_sketch_segments", "get_sketch_status", "add_line", "draw_line", "add_circle", "draw_circle", "add_rectangle", "draw_rectangle", "draw_centerline", "draw_point", "draw_arc", "draw_3point_arc", "draw_ellipse", "draw_polygon", "draw_slot", "draw_spline", "sketch_fillet", "sketch_chamfer", "sketch_trim", "sketch_offset", "sketch_mirror", "convert_entities", "set_construction_geometry", "add_relation", "add_dimension", "set_dimension", "list_dimensions" ]),
        new("Solid features", "Extrusions and the upstream feature set that still needs to be migrated.", ["create_extrusion", "boss_extrude", "cut_extrude", "revolve", "fillet", "chamfer", "shell", "draft", "rib", "simple_hole", "sweep", "loft", "linear_pattern", "circular_pattern", "mirror_feature", "delete_feature", "rename_feature", "set_feature_suppression"]),
        new("Inspection", "Topology listings, measurements, mass properties, screenshots, and diagnostics.", ["list_bodies", "list_faces", "list_edges", "list_vertices", "list_features", "get_bounding_box", "measure", "get_mass_properties", "check_errors", "set_view", "check_interference", "measure_distance", "analyze_draft", "check_geometry", "capture_screenshot"]),
        new("Assemblies", "Component insertion and mates.", ["list_components", "insert_component", "add_mate", "list_mates", "set_component_fixed"]),
        new("Engineering drawings", "Sheets, views, model items, dimensions, center marks, and notes.", ["create_drawing", "create_drawing_from_model", "list_sheets", "add_sheet", "activate_sheet", "add_drawing_view", "insert_model_view", "insert_projected_view", "insert_section_view", "insert_detail_view", "list_drawing_views", "activate_drawing_view", "set_drawing_view", "create_drawing_sketch", "insert_model_annotations", "auto_dimension_view", "insert_center_marks", "insert_centerlines", "add_note"]),
        new("Automation helpers", "Export, templates, VBA, macro, and image tracing helpers.", ["export_file", "batch_export", "export_with_options", "capture_screenshot", "extract_drawing_template", "apply_drawing_template", "save_drawing_template", "generate_vba_script", "create_feature_vba", "create_batch_vba", "record_native_macro", "playback_native_macro", "trace_image_to_sketch", "trace_image_to_feature", "trace_image_to_drawing"])
    ];

    private static readonly JsonSerializerOptions ReadableJsonOptions = new()
    {
        WriteIndented = true,
        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    };

    private ChatRuntime? _loadedRuntime;
    private IReadOnlyList<McpToolDescriptor> _toolCatalog = [];
    private IReadOnlyDictionary<string, McpToolDescriptor> _toolCatalogByName = new Dictionary<string, McpToolDescriptor>(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<CapabilityGroupViewModel> _groups = [];
    private string? _selectedToolName;
    private string _statusText = "Connect to MCP to load the live tool catalog.";
    private string? _validationResult;
    private string _validationArgumentsJson = "{}";
    private string? _argumentEditorError;
    private bool _isRefreshing;
    private bool _isValidating;
    private JsonObject? _latestStructuredResult;
    private bool _useAdvancedJsonEditor;
    private string? _addToolTypePropertyName;
    private IReadOnlyList<string> _addToolTypeOptions = [];
    private string? _selectedAddToolType;
    private CircleValidationFormState _circleFormState = CircleValidationFormState.CreateDefault();
    private LineValidationFormState _lineFormState = LineValidationFormState.CreateDefault();
    private RectangleValidationFormState _rectangleFormState = RectangleValidationFormState.CreateDefault();
    private DimensionValidationFormState _dimensionFormState = DimensionValidationFormState.CreateDefault();

    protected override async Task OnParametersSetAsync()
    {
        if (Runtime is null)
        {
            _loadedRuntime = null;
            _toolCatalog = [];
            _toolCatalogByName = new Dictionary<string, McpToolDescriptor>(StringComparer.OrdinalIgnoreCase);
            _groups = [];
            _selectedToolName = null;
            _statusText = "Connect to MCP to load the live tool catalog.";
            _validationResult = null;
            _validationArgumentsJson = "{}";
            _argumentEditorError = null;
            _latestStructuredResult = null;
            _useAdvancedJsonEditor = false;
            _addToolTypePropertyName = null;
            _addToolTypeOptions = [];
            _selectedAddToolType = null;
            _circleFormState = CircleValidationFormState.CreateDefault();
            _lineFormState = LineValidationFormState.CreateDefault();
            _rectangleFormState = RectangleValidationFormState.CreateDefault();
            _dimensionFormState = DimensionValidationFormState.CreateDefault();
            return;
        }

        if (!ReferenceEquals(_loadedRuntime, Runtime))
        {
            await RefreshAsync();
        }
    }

    private ToolViewModel? SelectedTool
        => _selectedToolName is null
            ? null
            : _groups.SelectMany(group => group.Tools).FirstOrDefault(tool => string.Equals(tool.Name, _selectedToolName, StringComparison.OrdinalIgnoreCase));

    private McpToolDescriptor? SelectedToolDescriptor
        => SelectedTool is null || !_toolCatalogByName.TryGetValue(SelectedTool.Name, out var descriptor)
            ? null
            : descriptor;

    private bool CanRunSelectedTool
        => !_isRefreshing
           && !_isValidating
           && SelectedTool is not null
           && SelectedTool.IsAvailable;

    private bool IsSolidWorksStyleValidationSupportedTool(string? toolName)
        => IsCircleValidationTool(toolName)
            || IsLineValidationTool(toolName)
            || IsRectangleValidationTool(toolName)
            || IsDimensionValidationTool(toolName);

    private static bool IsCircleValidationTool(string? toolName)
        => !string.IsNullOrWhiteSpace(toolName)
            && (toolName.Equals("add_circle", StringComparison.OrdinalIgnoreCase)
                || toolName.Equals("draw_circle", StringComparison.OrdinalIgnoreCase));

    private static bool IsLineValidationTool(string? toolName)
        => !string.IsNullOrWhiteSpace(toolName)
            && (toolName.Equals("add_line", StringComparison.OrdinalIgnoreCase)
                || toolName.Equals("draw_line", StringComparison.OrdinalIgnoreCase));

    private static bool IsRectangleValidationTool(string? toolName)
        => !string.IsNullOrWhiteSpace(toolName)
            && (toolName.Equals("add_rectangle", StringComparison.OrdinalIgnoreCase)
                || toolName.Equals("draw_rectangle", StringComparison.OrdinalIgnoreCase));

    private static bool IsDimensionValidationTool(string? toolName)
        => !string.IsNullOrWhiteSpace(toolName)
            && toolName.Equals("add_dimension", StringComparison.OrdinalIgnoreCase);

    private static bool IsAddTool(string? toolName)
        => !string.IsNullOrWhiteSpace(toolName)
            && toolName.StartsWith("add_", StringComparison.OrdinalIgnoreCase);

    private bool ShowSolidWorksStyleValidationForm
        => !_useAdvancedJsonEditor
           && SelectedTool is not null
           && IsSolidWorksStyleValidationSupportedTool(SelectedTool.Name);

    private async Task RefreshAsync()
    {
        if (Runtime is null)
        {
            return;
        }

        _isRefreshing = true;
        _validationResult = null;
        _latestStructuredResult = null;

        try
        {
            _loadedRuntime = Runtime;
            _toolCatalog = await Runtime.GetToolCatalogAsync();
            _toolCatalogByName = _toolCatalog.ToDictionary(tool => tool.Name, StringComparer.OrdinalIgnoreCase);
            _groups = BuildGroups();
            _selectedToolName = _selectedToolName is not null && _toolCatalogByName.ContainsKey(_selectedToolName)
                ? _selectedToolName
                : _toolCatalog.FirstOrDefault()?.Name;
            ResetValidationArguments();
            _statusText = $"Loaded {_toolCatalog.Count} tools from MCP. {GetCoverageSummary()}";
        }
        catch (Exception ex)
        {
            _statusText = $"Failed to load tool catalog: {ex.Message}";
            _toolCatalog = [];
            _toolCatalogByName = new Dictionary<string, McpToolDescriptor>(StringComparer.OrdinalIgnoreCase);
            _groups = [];
            _selectedToolName = null;
            _validationArgumentsJson = "{}";
            _argumentEditorError = null;
            _useAdvancedJsonEditor = false;
            _addToolTypePropertyName = null;
            _addToolTypeOptions = [];
            _selectedAddToolType = null;
            _circleFormState = CircleValidationFormState.CreateDefault();
            _lineFormState = LineValidationFormState.CreateDefault();
            _rectangleFormState = RectangleValidationFormState.CreateDefault();
            _dimensionFormState = DimensionValidationFormState.CreateDefault();
        }
        finally
        {
            _isRefreshing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private IReadOnlyList<CapabilityGroupViewModel> BuildGroups()
    {
        return CapabilityGroups.Select(group =>
        {
            var tools = new List<ToolViewModel>(group.ToolNames.Length);
            var availableCount = 0;
            foreach (var toolName in group.ToolNames)
            {
                var available = _toolCatalogByName.TryGetValue(toolName, out var descriptor);
                if (available)
                {
                    availableCount++;
                }

                tools.Add(new ToolViewModel(
                    toolName,
                    descriptor?.Description ?? "Not currently exposed by the C# server.",
                    available,
                    available ? "available" : "missing",
                    GetSchemaText(descriptor)));
            }

            var coverageLabel = availableCount == 0
                ? "missing"
                : availableCount == group.ToolNames.Length
                    ? "covered"
                    : "partial";

            return new CapabilityGroupViewModel(group.Title, group.Description, coverageLabel, tools);
        }).ToArray();
    }

    private string GetCoverageSummary()
    {
        var covered = _groups.Count(group => string.Equals(group.CoverageLabel, "covered", StringComparison.OrdinalIgnoreCase));
        var partial = _groups.Count(group => string.Equals(group.CoverageLabel, "partial", StringComparison.OrdinalIgnoreCase));
        var missing = _groups.Count(group => string.Equals(group.CoverageLabel, "missing", StringComparison.OrdinalIgnoreCase));
        return $"{covered} covered, {partial} partial, {missing} missing capability groups.";
    }

    private static string? GetSchemaText(McpToolDescriptor? descriptor)
        => descriptor?.InputSchema?.ToJsonString(ReadableJsonOptions);

    private async Task OnSelectedToolChanged(string? toolName)
    {
        _selectedToolName = toolName;
        ResetValidationArguments();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RunSelectedValidationAsync()
    {
        if (!CanRunSelectedTool || SelectedTool is null || Runtime is null)
        {
            return;
        }

        JsonObject arguments;
        if (ShowSolidWorksStyleValidationForm && IsSolidWorksStyleValidationSupportedTool(SelectedTool.Name))
        {
            arguments = BuildSolidWorksStyleValidationArguments(SelectedTool.Name);
        }
        else
        {
            if (!TryParseValidationArguments(out arguments))
            {
                await InvokeAsync(StateHasChanged);
                return;
            }
        }

        var seededArguments = SeedValidationArgumentsFromLatestResult(SelectedTool.Name, arguments, _latestStructuredResult);
        ApplyAddToolTypePickerValue(seededArguments);
        _validationArgumentsJson = seededArguments.ToJsonString(ReadableJsonOptions);

        _isValidating = true;
        _validationResult = null;

        try
        {
            var result = await Runtime.InvokeToolAsync(SelectedTool.Name, seededArguments);
            _latestStructuredResult = result.StructuredData
                ?? TryParseJsonObject(result.DisplayText)
                ?? TryParseJsonObject(result.RawJson);
            _validationResult = string.Join("\n\n", new[]
            {
                result.DisplayText,
                result.StderrSummary,
                result.RawJson
            }.Where(value => !string.IsNullOrWhiteSpace(value)));
        }
        catch (Exception ex)
        {
            _validationResult = ex.Message;
        }
        finally
        {
            _isValidating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool TryParseValidationArguments(out JsonObject arguments)
    {
        arguments = new JsonObject();
        _argumentEditorError = null;

        var payload = string.IsNullOrWhiteSpace(_validationArgumentsJson) ? "{}" : _validationArgumentsJson;

        try
        {
            var parsed = JsonNode.Parse(payload);
            if (parsed is null)
            {
                arguments = new JsonObject();
                return true;
            }

            if (parsed is not JsonObject jsonObject)
            {
                _argumentEditorError = "Arguments must be a JSON object (for example: {} or {\"name\":\"value\"}).";
                return false;
            }

            arguments = jsonObject;
            return true;
        }
        catch (JsonException ex)
        {
            _argumentEditorError = $"Invalid JSON payload: {ex.Message}";
            return false;
        }
    }

    private void ResetValidationArguments()
    {
        var tool = SelectedTool;
        var descriptor = SelectedToolDescriptor;
        if (tool is null)
        {
            _validationArgumentsJson = "{}";
            _argumentEditorError = null;
            _addToolTypePropertyName = null;
            _addToolTypeOptions = [];
            _selectedAddToolType = null;
            _circleFormState = CircleValidationFormState.CreateDefault();
            _lineFormState = LineValidationFormState.CreateDefault();
            _rectangleFormState = RectangleValidationFormState.CreateDefault();
            _dimensionFormState = DimensionValidationFormState.CreateDefault();
            return;
        }

        InitializeValidationFormState(tool.Name);
        var arguments = BuildValidationArguments(tool.Name, descriptor?.InputSchema);
        var seededArguments = SeedValidationArgumentsFromLatestResult(tool.Name, arguments, _latestStructuredResult);
        ConfigureAddToolTypePicker(tool.Name, descriptor?.InputSchema, seededArguments);
        ApplyAddToolTypePickerValue(seededArguments);
        _validationArgumentsJson = seededArguments.ToJsonString(ReadableJsonOptions);
        _argumentEditorError = null;
    }

    private static JsonObject BuildValidationArguments(string toolName, JsonNode? schema)
        => BuildPresetValidationArguments(toolName)
            ?? BuildArgumentsFromSchema(schema)
            ?? new JsonObject();

    private JsonObject BuildSolidWorksStyleValidationArguments(string toolName)
    {
        ArgumentException.ThrowIfNullOrWhiteSpace(toolName);

        if (IsCircleValidationTool(toolName))
        {
            return BuildCircleValidationArguments();
        }

        if (IsLineValidationTool(toolName))
        {
            return BuildLineValidationArguments();
        }

        if (IsRectangleValidationTool(toolName))
        {
            return BuildRectangleValidationArguments();
        }

        if (IsDimensionValidationTool(toolName))
        {
            return BuildDimensionValidationArguments();
        }

        return new JsonObject();
    }

    private JsonObject BuildCircleValidationArguments()
    {
        var arguments = new JsonObject
        {
            ["centerX"] = _circleFormState.CenterXmm,
            ["centerY"] = _circleFormState.CenterYmm,
            ["centerZ"] = 0d,
            ["radius"] = Math.Max(_circleFormState.RadiusMm, 0.001d)
        };

        return arguments;
    }

    private JsonObject BuildLineValidationArguments()
    {
        var arguments = new JsonObject
        {
            ["x1"] = _lineFormState.X1mm,
            ["y1"] = _lineFormState.Y1mm,
            ["z1"] = 0d,
            ["x2"] = _lineFormState.X2mm,
            ["y2"] = _lineFormState.Y2mm,
            ["z2"] = 0d
        };

        return arguments;
    }

    private JsonObject BuildRectangleValidationArguments()
    {
        var arguments = new JsonObject
        {
            ["x1"] = _rectangleFormState.X1mm,
            ["y1"] = _rectangleFormState.Y1mm,
            ["x2"] = _rectangleFormState.X2mm,
            ["y2"] = _rectangleFormState.Y2mm
        };

        return arguments;
    }

    private JsonObject BuildDimensionValidationArguments()
    {
        var arguments = new JsonObject
        {
            ["selection"] = new JsonObject(),
            ["kind"] = string.IsNullOrWhiteSpace(_dimensionFormState.Kind) ? "auto" : _dimensionFormState.Kind,
            ["value_mm"] = _dimensionFormState.ValueMm,
            ["place_x_mm"] = _dimensionFormState.PlaceXmm,
            ["place_y_mm"] = _dimensionFormState.PlaceYmm,
            ["place_z_mm"] = 0d
        };

        if (_dimensionFormState.UseLatestSelection && _latestStructuredResult is not null)
        {
            MergeSelectionSeed(arguments, _latestStructuredResult);
        }

        JsonObject selection = arguments["selection"] as JsonObject ?? [];
        if (!string.IsNullOrWhiteSpace(_dimensionFormState.SketchName))
        {
            selection["sketch_name"] = _dimensionFormState.SketchName;
        }

        var handles = ParseCsvValues(_dimensionFormState.SketchSegmentsCsv);
        if (handles.Count > 0)
        {
            var segments = new JsonArray();
            foreach (var handle in handles)
            {
                segments.Add(handle);
            }

            selection["sketch_segments"] = segments;
        }

        arguments["selection"] = selection;
        return arguments;
    }

    private static JsonObject? BuildPresetValidationArguments(string toolName)
        => toolName.ToLowerInvariant() switch
        {
            "check_errors" => new JsonObject { ["rebuild_first"] = true },
            _ => null
        };

    private void ConfigureAddToolTypePicker(string toolName, JsonNode? schema, JsonObject arguments)
    {
        ArgumentException.ThrowIfNullOrWhiteSpace(toolName);
        ArgumentNullException.ThrowIfNull(arguments);

        _addToolTypePropertyName = null;
        _addToolTypeOptions = [];
        _selectedAddToolType = null;

        if (!IsAddTool(toolName) || !TryGetAddToolTypePickerDefinition(schema, out var propertyName, out var options, out var defaultValue))
        {
            return;
        }

        _addToolTypePropertyName = propertyName;
        _addToolTypeOptions = options;

        if (arguments[propertyName] is JsonValue argumentTypeValue && argumentTypeValue.TryGetValue<string>(out var argumentType) && options.Contains(argumentType, StringComparer.OrdinalIgnoreCase))
        {
            _selectedAddToolType = argumentType;
            return;
        }

        _selectedAddToolType = !string.IsNullOrWhiteSpace(defaultValue)
            ? defaultValue
            : options.FirstOrDefault();
    }

    private void ApplyAddToolTypePickerValue(JsonObject arguments)
    {
        ArgumentNullException.ThrowIfNull(arguments);
        if (string.IsNullOrWhiteSpace(_addToolTypePropertyName)
            || string.IsNullOrWhiteSpace(_selectedAddToolType)
            || _addToolTypeOptions.Count == 0)
        {
            return;
        }

        arguments[_addToolTypePropertyName] = _selectedAddToolType;
    }

    private static bool TryGetAddToolTypePickerDefinition(JsonNode? schema, out string propertyName, out IReadOnlyList<string> options, out string? defaultValue)
    {
        propertyName = string.Empty;
        options = [];
        defaultValue = null;

        if (schema is not JsonObject schemaObject || schemaObject["properties"] is not JsonObject properties)
        {
            return false;
        }

        foreach (var candidateProperty in new[] { "kind", "type", "mode", "relation" })
        {
            if (properties[candidateProperty] is not JsonObject propertySchema || propertySchema["enum"] is not JsonArray enumValues)
            {
                continue;
            }

            var extractedOptions = enumValues
                .OfType<JsonValue>()
                .Select(value => value.TryGetValue<string>(out var stringValue) ? stringValue : null)
                .Where(value => !string.IsNullOrWhiteSpace(value))
                .Select(value => value!)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray();

            if (extractedOptions.Length == 0)
            {
                continue;
            }

            propertyName = candidateProperty;
            options = extractedOptions;
            if (propertySchema["default"] is JsonValue defaultJsonValue && defaultJsonValue.TryGetValue<string>(out var defaultStringValue))
            {
                defaultValue = defaultStringValue;
            }

            return true;
        }

        return false;
    }

    private static JsonObject? BuildArgumentsFromSchema(JsonNode? schema)
    {
        var sample = BuildSampleValue(schema) as JsonObject;
        return sample;
    }

    private void InitializeValidationFormState(string toolName)
    {
        ArgumentException.ThrowIfNullOrWhiteSpace(toolName);

        if (IsCircleValidationTool(toolName))
        {
            _circleFormState = CircleValidationFormState.CreateDefault();
        }

        if (IsLineValidationTool(toolName))
        {
            _lineFormState = LineValidationFormState.CreateDefault();
        }

        if (IsRectangleValidationTool(toolName))
        {
            _rectangleFormState = RectangleValidationFormState.CreateDefault();
        }

        if (IsDimensionValidationTool(toolName))
        {
            _dimensionFormState = DimensionValidationFormState.CreateDefault();
        }
    }

    private static IReadOnlyList<string> ParseCsvValues(string? csv)
    {
        if (string.IsNullOrWhiteSpace(csv))
        {
            return [];
        }

        return csv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .ToArray();
    }

    private static JsonObject SeedValidationArgumentsFromLatestResult(string toolName, JsonObject arguments, JsonObject? latestResult)
    {
        ArgumentException.ThrowIfNullOrWhiteSpace(toolName);
        ArgumentNullException.ThrowIfNull(arguments);
        if (latestResult is null)
        {
            return arguments;
        }

        var seededArguments = (JsonObject)arguments.DeepClone();
        if (toolName.Equals("add_dimension", StringComparison.OrdinalIgnoreCase)
            || toolName.Equals("add_relation", StringComparison.OrdinalIgnoreCase)
            || toolName.Equals("set_construction_geometry", StringComparison.OrdinalIgnoreCase))
        {
            MergeSelectionSeed(seededArguments, latestResult);
        }

        return seededArguments;
    }

    private static void MergeSelectionSeed(JsonObject arguments, JsonObject latestResult)
    {
        ArgumentNullException.ThrowIfNull(arguments);
        ArgumentNullException.ThrowIfNull(latestResult);

        JsonObject selection = arguments["selection"] as JsonObject ?? [];
        var hasSelectionInArguments = arguments["selection"] is JsonObject;

        if (latestResult["selection"] is JsonObject latestSelection)
        {
            CopyIfMissing(selection, "sketch_name", latestSelection["sketch_name"]);
            CopyIfMissing(selection, "sketch_segments", latestSelection["sketch_segments"]);
            CopyIfMissing(selection, "sketch_points", latestSelection["sketch_points"]);
        }

        CopyIfMissing(selection, "sketch_name", latestResult["sketch_name"]);
        CopyIfMissing(selection, "sketch_segments", latestResult["sketch_segments"]);
        CopyIfMissing(selection, "sketch_points", latestResult["sketch_points"]);

        if (!hasSelectionInArguments && selection.Count > 0)
        {
            arguments["selection"] = selection;
        }
    }

    private static void CopyIfMissing(JsonObject target, string key, JsonNode? value)
    {
        ArgumentNullException.ThrowIfNull(target);
        ArgumentException.ThrowIfNullOrWhiteSpace(key);

        if (target.ContainsKey(key) || value is null)
        {
            return;
        }

        target[key] = value.DeepClone();
    }

    private static JsonObject? TryParseJsonObject(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return null;
        }

        try
        {
            return JsonNode.Parse(json) as JsonObject;
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private static JsonNode? BuildSampleValue(JsonNode? schemaNode, string? propertyName = null)
    {
        if (schemaNode is not JsonObject schema)
        {
            return null;
        }

        if (schema["default"] is JsonNode defaultValue)
        {
            return defaultValue.DeepClone();
        }

        if (schema["examples"] is JsonArray examples && examples.Count > 0 && examples[0] is JsonNode exampleValue)
        {
            return exampleValue.DeepClone();
        }

        if (schema["enum"] is JsonArray enumValues && enumValues.Count > 0 && enumValues[0] is JsonNode enumValue)
        {
            return enumValue.DeepClone();
        }

        if (schema["oneOf"] is JsonArray oneOf && oneOf.Count > 0)
        {
            return BuildSampleValue(oneOf[0], propertyName);
        }

        if (schema["anyOf"] is JsonArray anyOf && anyOf.Count > 0)
        {
            return BuildSampleValue(anyOf[0], propertyName);
        }

        if (schema["allOf"] is JsonArray allOf && allOf.Count > 0)
        {
            return BuildSampleValue(allOf[0], propertyName);
        }

        return GetSchemaType(schema) switch
        {
            "object" => BuildObjectSample(schema),
            "array" => BuildArraySample(schema, propertyName),
            "integer" => 1,
            "number" => 1.0,
            "boolean" => true,
            "string" => BuildStringSample(propertyName),
            _ => null
        };
    }

    private static JsonObject BuildObjectSample(JsonObject schema)
    {
        var sample = new JsonObject();
        if (schema["properties"] is JsonObject properties)
        {
            foreach (var property in properties)
            {
                sample[property.Key] = BuildSampleValue(property.Value, property.Key);
            }
        }

        if (schema["required"] is JsonArray required)
        {
            foreach (var requiredNode in required)
            {
                var propertyName = requiredNode?.GetValue<string>();
                if (string.IsNullOrWhiteSpace(propertyName) || sample.ContainsKey(propertyName))
                {
                    continue;
                }

                sample[propertyName] = BuildStringSample(propertyName);
            }
        }

        return sample;
    }

    private static JsonArray BuildArraySample(JsonObject schema, string? propertyName)
    {
        var sample = new JsonArray();
        var itemSample = BuildSampleValue(schema["items"], propertyName);
        if (itemSample is not null)
        {
            sample.Add(itemSample);
        }

        return sample;
    }

    private static string BuildStringSample(string? propertyName)
        => string.IsNullOrWhiteSpace(propertyName)
            ? "sample"
            : propertyName.Contains("path", StringComparison.OrdinalIgnoreCase)
                ? "<required-path>"
                : propertyName.Contains("name", StringComparison.OrdinalIgnoreCase)
                    ? "sample-name"
                    : propertyName.Contains("id", StringComparison.OrdinalIgnoreCase)
                        ? "sample-id"
                        : "sample";

    private static string? GetSchemaType(JsonObject schema)
    {
        if (schema["type"] is JsonValue typeValue && typeValue.TryGetValue<string>(out var directType))
        {
            return directType;
        }

        if (schema["type"] is not JsonArray typeArray)
        {
            return null;
        }

        foreach (var candidate in typeArray)
        {
            var value = candidate?.GetValue<string>();
            if (!string.IsNullOrWhiteSpace(value) && !string.Equals(value, "null", StringComparison.OrdinalIgnoreCase))
            {
                return value;
            }
        }

        return null;
    }

    private void SelectFirstAvailableTool()
    {
        var toolName = _toolCatalog.FirstOrDefault()?.Name;
        if (!string.IsNullOrWhiteSpace(toolName))
        {
            _selectedToolName = toolName;
            ResetValidationArguments();
        }
    }

    private static Color GetToolStatusColor(bool isAvailable)
        => isAvailable ? Color.Success : Color.Error;

    private sealed record CapabilityGroupDefinition(string Title, string Description, string[] ToolNames);

    private sealed record CapabilityGroupViewModel(string Title, string Description, string CoverageLabel, IReadOnlyList<ToolViewModel> Tools);

    private sealed record ToolViewModel(string Name, string Description, bool IsAvailable, string StatusLabel, string? InputSchemaJson)
    {
        public string Label => $"{Name} ({StatusLabel})";
        public string ValidationNote => IsAvailable
            ? "This tool is exposed by the current C# server. Start from the generated sample payload and adjust arguments before running the test."
            : "This tool is listed in the upstream capability map but is not yet exposed by the current C# server.";
    }

