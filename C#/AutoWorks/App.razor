<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6">SolidWorks Orchestrator</MudText>
        <MudSpacer />
        <MudChip T="string" Color="@GetStatusColor()" Variant="Variant.Filled">@statusText</MudChip>
    </MudAppBar>

    <MudMainContent>
        <ChatWorkspace OnStatusChanged="OnStatusChanged" />
    </MudMainContent>
</MudLayout>

@code {
    private string statusText = "Status: disconnected";

    private void OnStatusChanged(string status)
    {
        statusText = status;
        StateHasChanged();
    }

    private Color GetStatusColor()
    {
        if (statusText.Contains("connecting", StringComparison.OrdinalIgnoreCase))
        {
            return Color.Info;
        }

        if (statusText.Contains("failed", StringComparison.OrdinalIgnoreCase))
        {
            return Color.Error;
        }

        if (statusText.Contains("warm-up skipped/failed", StringComparison.OrdinalIgnoreCase))
        {
            return Color.Warning;
        }

        return statusText.Contains("connected", StringComparison.OrdinalIgnoreCase)
            ? Color.Success
            : Color.Default;
    }
}
